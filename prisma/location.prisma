model LocationType {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createAt  DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  locations Location[]

  @@map("location_type")
}

model Location {
  id          Int               @id @default(autoincrement())
  name        String
  createAt    DateTime          @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt   DateTime          @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  lct_type_id Int               @default(1)
  dayplans    DayplanTimeline[]
  lct_type    LocationType      @relation(fields: [lct_type_id], references: [id], onDelete: Cascade)
  packages    Package[]
  partner     Partner[]
  costItems   PackageCostItem[]

  @@map("location")
}
