model Package {
  id                 Int               @id @default(autoincrement())
  name               String
  description        String?
  price              Float?
  status             String            @default("Draft")
  image              String?
  createdAt          DateTime          @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt          DateTime          @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  location_id        Int?
  partner_id         Int?
  booking_end_date   DateTime?
  booking_start_date DateTime?
  start_date         DateTime?
  end_date           DateTime?
  insurance_plan_id  Int?
  target_travelers   Int?
  minimum_travelers  Int?
  costItems          PackageCostItem[]
  addons             AddonPackage[]
  bookingCollaps     BookingCollaps[]
  bookings           Booking[]
  dayplans           DayplanTimeline[]
  packageGuides      PackageGuide[]
  packageBuses       PackageBus[]
  images             PackageImage[]
  partners           PackagePartner[]
  location           Location?         @relation(fields: [location_id], references: [id])
  partner            Partner?          @relation(fields: [partner_id], references: [id])
  insurancePlan      InsurancePlan?    @relation(fields: [insurance_plan_id], references: [id], onDelete: SetNull)

  @@index([insurance_plan_id])
  @@map("packages")
}

model PackageCostItem {
  id                   Int      @id @default(autoincrement())
  package_id           Int
  location_id          Int?
  partner_id           Int?
  itinerary_place      String?
  category             String
  supplier_name        String
  pricing_mode         String   @default("FIXED")
  amount_satang        Int
  deposit_satang       Int      @default(0)
  paid_deposit_satang  Int      @default(0)
  paid_balance_satang  Int      @default(0)
  package              Package  @relation(fields: [package_id], references: [id], onDelete: Cascade)
  location             Location? @relation(fields: [location_id], references: [id], onDelete: Restrict)
  partner              Partner?  @relation(fields: [partner_id], references: [id], onDelete: Restrict)

  @@index([package_id])
  @@index([location_id])
  @@index([partner_id])
  @@map("package_cost_items")
}

model PackageGuide {
  id         Int      @id @default(autoincrement())
  package_id Int
  emp_id     Int
  role       String?  @default("LEAD_GUIDE")
  note       String?
  createdAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  emp        Emp      @relation(fields: [emp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  package    Package  @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([package_id, emp_id])
  @@map("package_guides")
}

model AddonPackage {
  id             Int            @id @default(autoincrement())
  addon_name     String
  price          Float          @default(0)
  max_limit      Int            @default(1)
  status         Int            @default(1)
  package_id     Int
  createdAt      DateTime       @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt      DateTime       @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  package        Package        @relation(fields: [package_id], references: [id], onDelete: Cascade)
  booking_addons BookingAddon[]

  @@map("addon_package")
}

model DayplanTimeline {
  id          Int                @id @default(autoincrement())
  day_num     Int
  title       String?
  dt          String?
  description String?
  hotel       String?
  location_id Int?
  package_id  Int
  activities  ActivityTimeline[]
  meals       DayplanMeal[]
  location    Location?          @relation(fields: [location_id], references: [id])
  package     Package            @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("dayplan_timeline")
}

model ActivityTimeline {
  id         Int             @id @default(autoincrement())
  time       String?
  activity   String
  status     String?         @default("include")
  landmark   String?
  dayplan_id Int
  dayplan    DayplanTimeline @relation(fields: [dayplan_id], references: [id], onDelete: Cascade)

  @@map("activity_timeline")
}

model Meal {
  id        Int           @id @default(autoincrement())
  type_name String        @unique
  dayplans  DayplanMeal[]

  @@map("meal")
}

model DayplanMeal {
  id_dayplan Int
  id_meal    Int
  dayplan    DayplanTimeline @relation(fields: [id_dayplan], references: [id], onDelete: Cascade)
  meal       Meal            @relation(fields: [id_meal], references: [id], onDelete: Cascade)

  @@id([id_dayplan, id_meal])
  @@map("dayplan_meal")
}

model PackageImage {
  id         Int      @id @default(autoincrement())
  package_id Int
  image_url  String
  is_cover   Boolean  @default(false)
  sort_order Int      @default(0)
  caption    String?
  createdAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  package    Package  @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("package_images")
}
