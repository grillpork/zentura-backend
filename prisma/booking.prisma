model Booking {
  id                Int                @id @default(autoincrement())
  booking_code      String             @unique
  package_id        Int
  user_id           Int?
  travel_date       DateTime
  adult_count       Int                @default(1)
  child_count       Int                @default(0)
  contact_name      String
  contact_phone     String
  contact_email     String
  contact_line_id   String?
  special_request   String?
  package_price     Float
  addon_total       Float              @default(0)
  total_price       Float
  status            String             @default("PENDING_PAYMENT")
  createdAt         DateTime           @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt         DateTime           @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  discount_code     String?
  discount_amount   Float              @default(0)
  points_earned     Int                @default(0)
  booking_addons    BookingAddon[]
  bookingCollaps    BookingCollaps[]
  travelers         BookingTraveler[]
  package           Package            @relation(fields: [package_id], references: [id])
  user              User?              @relation(fields: [user_id], references: [id])
  payments          Payment[]
  pointTransactions PointTransaction[]

  @@map("bookings")
}

model BookingTraveler {
  id                  Int     @id @default(autoincrement())
  booking_id          Int
  title               String?
  full_name           String
  id_card_or_passport String?
  phone               String?
  booking             Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("booking_travelers")
}

model BookingAddon {
  id         Int          @id @default(autoincrement())
  booking_id Int
  addon_id   Int
  addon_name String
  price      Float
  quantity   Int          @default(1)
  addon      AddonPackage @relation(fields: [addon_id], references: [id])
  booking    Booking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("booking_addons")
}

model Payment {
  id             Int       @id @default(autoincrement())
  booking_id     Int
  amount         Float
  payment_method String    @default("TRANSFER")
  slip_url       String?
  paid_at        DateTime?
  status         String    @default("PENDING")
  reject_reason  String?
  verified_by    Int?
  verified_at    DateTime?
  createdAt      DateTime  @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  booking        Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("payments")
}
