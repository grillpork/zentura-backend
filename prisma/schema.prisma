generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  access    String?  @default("General access")

  users     User[]
  Emp       Emp[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  lineId    String?
  age       Int?
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
}

model Emp {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String   @default("123456")
  lineId        String?
  age           Int?
  roleId        Int
  phone         String?
  status        String?  @default("ใช้งาน")
  isPasswordSet Int?     @default(0)
  Role          Role     @relation(fields: [roleId], references: [id])
  createdAt     DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt     DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
}

model LocationType {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createAt  DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  locations Location[]

  @@map("location_type")
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  createAt    DateTime     @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt   DateTime     @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  lct_type_id Int          @default(1)
  lct_type    LocationType @relation(fields: [lct_type_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("location")
}
