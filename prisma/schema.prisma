generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  createAt DateTime @default(dbgenerated("timezone('Asia/Bangkok', now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok', now())"))
}
