generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  access    String?  @default("General access")

  users     User[]
  Emp       Emp[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  lineId    String?
  age       Int?
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  bookings  Booking[]
}

model Emp {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String   @default("123456")
  lineId        String?
  age           Int?
  roleId        Int
  phone         String?
  status        String?  @default("ใช้งาน")
  isPasswordSet Int?     @default(0)
  Role          Role     @relation(fields: [roleId], references: [id])
  createdAt     DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt     DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
}

model LocationType {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createAt  DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime   @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  locations Location[]

  @@map("location_type")
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  createAt    DateTime     @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt   DateTime     @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  lct_type_id Int          @default(1)
  lct_type    LocationType @relation(fields: [lct_type_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  packages    Package[]
  dayplans    DayplanTimeline[]

  @@map("location")
}

model PartnerType{
  id Int @id @default(autoincrement())
  name String @unique
  createAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  
  partners Partner[]

  @@map("partner_type")
}

model Partner{
  id Int @id @default(autoincrement())
  name String @unique
  phone String @unique
  email String @unique
  address String?
  createAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  
  pt_type_id Int
  pt_type PartnerType @relation(fields: [pt_type_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  packages        Package[]
  packagePartners PackagePartner[]

  @@map("partner")
}

model Package {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float?
  status      String   @default("Draft")
  image       String?
  createdAt   DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt   DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  location_id Int?
  location    Location? @relation(fields: [location_id], references: [id])

  partner_id  Int?
  partner     Partner?  @relation(fields: [partner_id], references: [id])

  dayplans    DayplanTimeline[]
  partners    PackagePartner[]
  addons      AddonPackage[]
  images      PackageImage[]
  bookings    Booking[]

  @@map("packages")
}

model AddonPackage {
  id          Int      @id @default(autoincrement())
  addon_name  String
  price       Float    @default(0)
  max_limit   Int      @default(1)
  status      Int      @default(1) // 1 = ซื้อได้, 0 = ซื้อไม่ได้

  booking_addons    BookingAddon[]
  
  package_id  Int
  package     Package  @relation(fields: [package_id], references: [id], onDelete: Cascade)
  

  createdAt   DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt   DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  @@map("addon_package")

  
}

model PackagePartner {
  package_id Int
  partner_id Int

  package    Package @relation(fields: [package_id], references: [id], onDelete: Cascade)
  partner    Partner @relation(fields: [partner_id], references: [id], onDelete: Cascade)

  @@id([package_id, partner_id])
  @@map("package_partners")
}

model DayplanTimeline {
  id          Int      @id @default(autoincrement())
  day_num     Int
  title       String?
  dt          String?  
  description String?
  hotel       String?
  
  location_id Int?
  location    Location? @relation(fields: [location_id], references: [id])

  package_id  Int
  package     Package  @relation(fields: [package_id], references: [id], onDelete: Cascade)

  activities  ActivityTimeline[]
  meals       DayplanMeal[]

  @@map("dayplan_timeline")
}

model ActivityTimeline {
  id          Int      @id @default(autoincrement())
  time        String?
  activity    String
  status      String?  @default("include")
  landmark    String?

  dayplan_id  Int
  dayplan     DayplanTimeline @relation(fields: [dayplan_id], references: [id], onDelete: Cascade)

  @@map("activity_timeline")
}

model Meal {
  id        Int      @id @default(autoincrement())
  type_name String   @unique

  dayplans  DayplanMeal[]

  @@map("meal")
}

model DayplanMeal {
  id_dayplan Int
  id_meal    Int

  dayplan    DayplanTimeline @relation(fields: [id_dayplan], references: [id], onDelete: Cascade)
  meal       Meal            @relation(fields: [id_meal], references: [id], onDelete: Cascade)

  @@id([id_dayplan, id_meal])
  @@map("dayplan_meal")
}

model PackageImage {
  id         Int      @id @default(autoincrement())
  package_id Int
  package    Package  @relation(fields: [package_id], references: [id], onDelete: Cascade)
  image_url  String
  is_cover   Boolean  @default(false)
  sort_order Int      @default(0)
  caption    String?

  createdAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt  DateTime @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  @@map("package_images")
}

model Booking {
  id              Int            @id @default(autoincrement())
  booking_code    String         @unique // รหัสการจอง เช่น ZT-202610-001 (สำหรับลูกค้าค้นหา)
  
  // เชื่อมกับแพ็กเกจ
  package_id      Int
  package         Package        @relation(fields: [package_id], references: [id], onDelete: Restrict)
  
  // เชื่อมกับผู้ใช้ (ถ้าล็อกอิน) หากลูกค้าทั่วไปไม่ได้ล็อกอินจะเป็น null
  user_id         Int?
  user            User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  
  // รายละเอียดการเดินทาง
  travel_date     DateTime       // วันที่ออกเดินทาง
  adult_count     Int            @default(1) // จำนวนผู้ใหญ่
  child_count     Int            @default(0) // จำนวนเด็ก (ถ้ามี)
  
  // ข้อมูลผู้ติดต่อหลัก
  contact_name    String
  contact_phone   String
  contact_email   String
  contact_line_id String?
  special_request String?        // คำขอพิเศษ เช่น แพ้อาหาร, วีลแชร์
  
  // ข้อมูลราคา (บันทึกราคา ณ วันที่จอง เพื่อป้องกันราคาแพ็กเกจเปลี่ยนในอนาคต)
  package_price   Float          // ราคาต่อท่าน ณ เวลาที่จอง
  addon_total     Float          @default(0)
  total_price     Float          // ยอดสุทธิ
  
  // สถานะการจอง: "PENDING_PAYMENT", "AWAITING_VERIFICATION", "CONFIRMED", "CANCELLED"
  status          String         @default("PENDING_PAYMENT")
  
  // ความสัมพันธ์กับตารางอื่นๆ
  travelers       BookingTraveler[]
  booking_addons  BookingAddon[]
  payments        Payment[]

  createdAt       DateTime       @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))
  updatedAt       DateTime       @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  @@map("bookings")
}

// รายชื่อผู้ร่วมเดินทางแต่ละท่าน (จำเป็นสำหรับทำประกันภัย / รายชื่อตั๋ว)
model BookingTraveler {
  id                 Int      @id @default(autoincrement())
  booking_id         Int
  booking            Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  
  title              String?  // นาย, นาง, นางสาว, เด็กชาย, เด็กหญิง
  full_name          String
  id_card_or_passport String? // เลขบัตร ปชช. หรือ Passport
  phone              String?

  @@map("booking_travelers")
}

// Addon ที่ลูกค้าเลือกจองใน Order นั้นๆ
model BookingAddon {
  id          Int          @id @default(autoincrement())
  booking_id  Int
  booking     Booking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  
  addon_id    Int
  addon       AddonPackage @relation(fields: [addon_id], references: [id], onDelete: Restrict)
  
  addon_name  String       // เก็บชื่อไว้เพื่ออ้างอิงย้อนหลัง
  price       Float        // ราคาต่อหน่วย ณ วันที่จอง
  quantity    Int          @default(1)

  @@map("booking_addons")
}

// ประวัติการชำระเงินและแนบสลิป
model Payment {
  id             Int       @id @default(autoincrement())
  booking_id     Int
  booking        Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  
  amount         Float     // ยอดเงินที่แจ้งโอน
  payment_method String    @default("TRANSFER") // TRANSFER (โอนเงิน), PROMPTPAY
  slip_url       String?   // URL รูปสลิปจากระบบ Upload
  paid_at        DateTime? // วัน-เวลาที่โอน
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  reject_reason  String?   // กรณีแอดมินปฏิเสธสลิป
  verified_by    Int?      // รหัสเจ้าหน้าที่ (Emp) ที่ตรวจสอบ
  verified_at    DateTime?

  createdAt      DateTime  @default(dbgenerated("timezone('Asia/Bangkok'::text, now())"))

  @@map("payments")
}
